<?xml version="1.0" encoding="utf-8"?>
<!--
  Immagine della splash: tessera del marchio e sotto il nome "EINA".
  Il nome e' disegnato a tratti (stesso stile monolinea della lettera nel logo) e non come testo:
  questa immagine la disegna il sistema prima che l'app esista, come windowBackground sotto
  Android 12 e come windowSplashScreenAnimatedIcon da Android 12 in su, e li' non c'e' un font.
  Canvas quadrata perche' la splash di sistema mette l'icona in un riquadro quadrato.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!--
      La splash di sistema ritaglia l'icona dentro un cerchio: il marchio va rimpicciolito
      perche' ci stia tutto, nome compreso (senza, le lettere restano tagliate sotto).
    -->
    <group android:pivotX="100" android:pivotY="100" android:scaleX="0.72" android:scaleY="0.72">

    <!-- Tessera del marchio, identica a ic_eina_logo.xml. -->
    <group android:translateX="46" android:translateY="18">
        <path android:pathData="M62.14,0 C75.35,0 81.95,0 89.06,2.25 C96.82,6.65 101.35,11.18 105.75,18.94 C108,26.05 108,32.65 108,45.86 L108,62.14 C108,75.35 108,81.95 105.75,89.06 C101.35,96.82 96.82,101.35 89.06,105.75 C81.95,108 75.35,108 62.14,108 L45.86,108 C32.65,108 26.05,108 18.94,105.75 C11.18,101.35 6.65,96.82 2.25,89.06 C0,81.95 0,75.35 0,62.14 L0,45.86 C0,32.65 0,26.05 2.25,18.94 C6.65,11.18 11.18,6.65 18.94,2.25 C26.05,0 32.65,0 45.86,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="6"
                    android:startY="0"
                    android:endX="102"
                    android:endY="108">
                    <item android:offset="0" android:color="#FFA23A" />
                    <item android:offset="0.5" android:color="#F97348" />
                    <item android:offset="1" android:color="#F9436B" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M80.2,32 L35.2,32 L29,76 L75,76" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:pathData="M32.1,54 L66.1,54" />
    </group>

    <!--
      EINA: quattro lettere a tratto, altezza 30, spessore 7. Le distanze non sono uguali fra
      loro ma pareggiate a occhio (la A e' un triangolo e porta gia' aria a sinistra), e la
      parola e' larga quanto la tessera: cosi' il blocco si legge centrato.
    -->
    <group android:translateY="18">
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M66,130 L42,130 L42,160 L66,160" />
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M42,145 L60,145" />
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M81,130 L81,160" />
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M96,160 L96,130 L120,160 L120,130" />
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M132,160 L145,130 L158,160" />
        <path
            android:strokeColor="#1C1B19"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M137,151 L153,151" />
    </group>
    </group>
</vector>

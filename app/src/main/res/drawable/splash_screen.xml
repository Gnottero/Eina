<?xml version="1.0" encoding="utf-8"?>
<!--
  windowBackground dell'app: e' il primo fotogramma, quello che il sistema disegna prima ancora
  che l'Activity esista, quindi l'avvio mostra subito marchio e nome invece di un bianco vuoto.
  Resta dietro al contenuto per tutta la vita dell'app, ma il contenuto e' opaco e lo copre.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <!--
      L'inset in alto sposta il blocco 28dp piu' in basso: cosi' la tessera finisce al centro
      esatto dello schermo, dove la mette anche SplashOverlay.
    -->
    <item
        android:drawable="@drawable/ic_eina_splash_mark"
        android:gravity="center"
        android:top="56dp"
        android:width="200dp"
        android:height="164dp" />
</layer-list>
